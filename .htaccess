<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Preserve bearer/API Authorization headers for Laravel and Sanctum.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Never expose Laravel application/runtime files from this root folder.
    RewriteRule ^(?:\.env|\.env\..*|artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|server\.php|vite\.config\.js|\.git.*)$ - [F,L,NC]
    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|storage|tests|vendor)(?:/|$) - [F,L,NC]
    RewriteRule \.(?:trojan|bak|old|orig)$ - [F,L,NC]

    # Requests already targeting public/ are handled directly.
    RewriteRule ^public/ - [L]

    # Serve real public assets through the Laravel public directory.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d [OR]
    RewriteCond public/$1 -f [OR]
    RewriteCond public/$1 -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Route every other request through Laravel's front controller without appending PATH_INFO.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ public/index.php [L]
</IfModule>
